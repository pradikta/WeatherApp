{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenWeatherMap": {
    "BaseAddress": "https://api.openweathermap.org/",
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Resilience": {
    "TotalRequestTimeout": { "Timeout": "00:00:30" },
    "AttemptTimeout": { "Timeout": "00:00:05" },
    "Retry": { "MaxRetryAttempts": 2, "Delay": "00:00:01" },
    "CircuitBreaker": {
      "FailureRatio": 0.5,
      "MinimumThroughput": 10,
      "SamplingDuration": "00:00:30",
      "BreakDuration": "00:00:30"
    }
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Caching": {
    "WeatherCacheDurationMinutes": 1
  }
}

